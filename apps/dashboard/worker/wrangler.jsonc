{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundia-runtime-node-dev",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boundia-local",
      "database_id": "local"
    }
  ],
  "observability": {
    "enabled": true
  }
}
